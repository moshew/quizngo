# Port the API listens on (nginx / Vite proxy /api here)
APP_PORT=5020
APP_HOST=127.0.0.1

# Auth provider: dev (trusts submitted email/name) | oidc (SSO, not configured yet)
AUTH_PROVIDER=dev

# Comma-separated CORS origins
APP_ALLOWED_ORIGINS=http://localhost:3004,http://127.0.0.1:3004,https://quizngo.online,https://app.quizngo.online
